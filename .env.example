# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/watermate"
DIRECT_URL="postgresql://postgres:password@localhost:5432/watermate"

# Secret used to sign JWTs - change this to a long random string in production
JWT_SECRET="change-this-secret"

# Port the backend server (and frontend static files) will run on
PORT=5000

# Node environment
NODE_ENV=development

# WaterMate Storage: Supabase Storage
# Required in production on Vercel for persistent cross-device water photos and chat media.
# In local development only, falls back to local disk if omitted.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="watermate-chat"
SUPABASE_WATER_BUCKET="water-deliveries"

# WaterMate 2.0: Push Notifications (Server-Side Firebase Cloud Messaging)
# Optional: if omitted, in-app notification center operates seamlessly
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# WaterMate 2.0: Vercel Cron Security
CRON_SECRET=""
