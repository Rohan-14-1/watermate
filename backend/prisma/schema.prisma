// WaterMate - Prisma schema
// Run `npx prisma migrate dev --name init` (from repo root: npm run prisma:migrate)
// after setting DATABASE_URL in your .env file.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Groups this user created
  createdGroups Group[]       @relation("GroupCreator")
  // Memberships (join table) linking this user to groups
  memberships   GroupMember[]
  // Water deliveries this user has completed
  waterRecords  WaterRecord[]
  // Push device tokens registered for this user
  devices       UserDevice[]
  // Notifications received by this user
  notifications Notification[] @relation("UserNotifications")
  // Chat messages sent by this user
  chatMessages  ChatMessage[]  @relation("UserChatMessages")
  // Chicken turn relationships
  chickenTurnsCurrentUser   ChickenTurn[]     @relation("ChickenTurnCurrentUser")
  chickenDeliveriesBrought  ChickenDelivery[] @relation("ChickenBroughtBy")
  chickenDeliveriesApproved ChickenDelivery[] @relation("ChickenApprovedBy")

  @@map("users")
}

model Group {
  id         String   @id @default(uuid())
  name       String
  inviteCode String   @unique
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  creator           User              @relation("GroupCreator", fields: [createdBy], references: [id])
  members           GroupMember[]
  waterRecords      WaterRecord[]
  notifications     Notification[]
  chatMessages      ChatMessage[]
  chickenTurn       ChickenTurn?
  chickenDeliveries ChickenDelivery[]

  @@index([createdBy])
  @@map("groups")
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  // Position in the rotation, starting at 1. Determines turn order.
  turnOrder Int
  // Whether this member currently holds the turn. Exactly one member per
  // group should have isCurrentTurn = true at any time.
  isCurrentTurn Boolean @default(false)
  joinedAt  DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user cannot join the same group twice.
  @@unique([groupId, userId])
  // Turn order positions must be unique within a group.
  @@unique([groupId, turnOrder])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

model WaterRecord {
  id          String   @id @default(uuid())
  groupId     String
  userId      String
  photoUrl    String
  // Server-generated timestamp - the source of truth for when the delivery
  // was completed. Never accepted from the client.
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId])
  @@index([completedAt])
  @@map("water_records")
}

// -------------------------------------------------------------
// WaterMate 2.0: Notifications, Devices & Team Chat
// -------------------------------------------------------------

model UserDevice {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String   // "android", "ios", "web"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_devices")
}

model Notification {
  id          String    @id @default(uuid())
  userId      String    // Recipient user
  groupId     String
  type        String    // "WATER_TURN", "MANUAL_TEAM"
  title       String
  body        String
  senderId    String?   // null for automatic water turn notifications
  isRead      Boolean   @default(false)
  readAt      DateTime?
  referenceId String?   // turn event key, record id, or message id
  createdAt   DateTime  @default(now())

  user  User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([groupId])
  @@index([createdAt])
  @@map("notifications")
}

model WaterTurnNotificationLog {
  id               String   @id @default(uuid())
  groupId          String
  userId           String
  turnEventKey     String   // e.g. "active_<groupId>_<userId>_<date>"
  notificationType String   // "ACTIVE_TURN", "UPCOMING_REMINDER"
  sentAt           DateTime @default(now())

  @@unique([groupId, userId, turnEventKey, notificationType])
  @@index([groupId, userId])
  @@map("water_turn_notification_logs")
}

model ChatMessage {
  id        String   @id @default(uuid())
  groupId   String
  senderId  String
  text      String?
  createdAt DateTime @default(now())
  expiresAt DateTime // Server calculated: createdAt + 7 days

  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender      User             @relation("UserChatMessages", fields: [senderId], references: [id], onDelete: Cascade)
  attachments ChatAttachment[]

  @@index([groupId, createdAt])
  @@index([expiresAt])
  @@map("chat_messages")
}

model ChatAttachment {
  id          String   @id @default(uuid())
  messageId   String
  fileName    String
  fileType    String   // "IMAGE", "VIDEO", "DOCUMENT"
  mimeType    String
  fileSize    Int
  storagePath String   // Persistent object storage reference/path
  createdAt   DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("chat_attachments")
}

// -------------------------------------------------------------
// Chicken Turn System (Decoupled from Water Turn)
// -------------------------------------------------------------

model ChickenTurn {
  id                String   @id @default(uuid())
  groupId           String   @unique
  currentUserId     String?
  status            String   @default("WAITING_FOR_COMPLETION") // WAITING_FOR_COMPLETION, WAITING_FOR_APPROVAL
  pendingDeliveryId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  group           Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  currentUser     User?            @relation("ChickenTurnCurrentUser", fields: [currentUserId], references: [id], onDelete: SetNull)
  pendingDelivery ChickenDelivery? @relation("ChickenTurnPendingDelivery", fields: [pendingDeliveryId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@map("chicken_turns")
}

model ChickenDelivery {
  id           String    @id @default(uuid())
  groupId      String
  broughtById  String
  approvedById String?
  status       String    @default("WAITING_FOR_APPROVAL") // WAITING_FOR_APPROVAL, APPROVED
  completedAt  DateTime  @default(now())
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())

  group        Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  broughtBy    User          @relation("ChickenBroughtBy", fields: [broughtById], references: [id], onDelete: Cascade)
  approvedBy   User?         @relation("ChickenApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  pendingTurns ChickenTurn[] @relation("ChickenTurnPendingDelivery")

  @@index([groupId, createdAt])
  @@index([groupId, status])
  @@map("chicken_deliveries")
}
